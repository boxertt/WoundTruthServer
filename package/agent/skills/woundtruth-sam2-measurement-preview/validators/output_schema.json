{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WoundTruth SAM2 measurement preview response",
  "type": "object",
  "required": ["schemaVersion", "status", "clinicalWriteAllowed", "trials", "pairwiseMaskIoU", "assessment"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"const": "experimentalPreviewOnly"},
    "clinicalWriteAllowed": {"const": false},
    "trials": {"type": "array", "minItems": 3, "maxItems": 3},
    "pairwiseMaskIoU": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "assessment": {
      "type": "object",
      "required": ["accepted", "clinicalWriteAllowed", "refusalReasons", "stability", "measurementCandidate"],
      "properties": {
        "accepted": {"type": "boolean"},
        "clinicalWriteAllowed": {"const": false},
        "refusalReasons": {"type": "array", "items": {"type": "string"}},
        "measurementCandidate": {"type": ["object", "null"]},
        "stability": {"type": "object"}
      }
    }
  }
}
